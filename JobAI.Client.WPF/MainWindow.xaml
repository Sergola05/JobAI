<Window x:Class="JobAI.Client.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobAI.Client.WPF"
        mc:Ignorable="d"
        Title="JobAI - Генератор сопроводительных писем" Height="700" Width="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Генератор сопроводительных писем" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: Вакансии -->
            <GroupBox Grid.Column="0" Header="Вакансии" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button Content="Добавить" Click="AddVacancy_Click" Margin="0,0,5,0" Padding="10,5"/>
                        <Button Content="Удалить" Click="DeleteVacancy_Click" Padding="10,5" 
                                IsEnabled="False" Name="DeleteVacancyButton"/>
                    </StackPanel>
                    
                    <ListBox Grid.Row="1" Name="VacanciesListBox" 
                             SelectionChanged="VacanciesListBox_SelectionChanged"
                             Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Company}" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="DarkGray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Правая панель: Письма и генерация -->
            <GroupBox Grid.Column="2" Header="Сопроводительные письма" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button Content="Сгенерировать письмо" Click="GenerateLetter_Click" 
                                Padding="10,5" Margin="0,0,5,0" IsEnabled="False" Name="GenerateButton"/>
                    </StackPanel>

                    <!-- Список писем -->
                    <ListBox Grid.Row="1" Name="LettersListBox" 
                             SelectionChanged="LettersListBox_SelectionChanged"
                             Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding CandidateName}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Создано: {0:dd.MM.yyyy HH:mm}'}" 
                                               FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Текст письма -->
                    <GroupBox Grid.Row="2" Header="Текст письма" Margin="5,5,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <TextBox Name="LetterTextBox" TextWrapping="Wrap" 
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Margin="5" Text="Выберите письмо для просмотра"
                                         IsReadOnly="True"/>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="5">
                                <Button Content="Сохранить изменения"
                                        Click="SaveLetter_Click"
                                        Padding="10,5"
                                        Margin="0,0,5,0"
                                        IsEnabled="False"
                                        Name="SaveLetterButton"/>
                                <Button Content="Сохранить как..."
                                        Click="ExportLetter_Click"
                                        Padding="10,5"
                                        Name="ExportLetterButton"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Name="StatusTextBlock" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
